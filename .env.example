# ============================================================
# erreetool environment configuration
# ------------------------------------------------------------
# Copy this file to `.env` and fill in your API keys:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# The `.env` file is git-ignored — never commit real keys.
# ============================================================

# ------------------------------------------------------------
# LLM Providers (at least one is required for AI reasoning)
# ------------------------------------------------------------
# Priority order (first available is tried first):
# 1. OpenRouter — one key gives access to many free/paid models.
#    Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Groq — fast inference with generous free tier.
#    Get one at: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Together.ai — many open models, free tier available.
#    Get one at: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=tgp_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. NVIDIA NIM — hosted open models, free tier available.
#    Get one at: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional aliases
# NIM_API_KEY=

# ------------------------------------------------------------
# Model selection (optional overrides)
# ------------------------------------------------------------
# OpenRouter model (default: openrouter/auto)
# OPENROUTER_MODEL=google/gemini-flash-1.5

# Groq model (default: llama-3.1-70b-versatile)
# GROQ_MODEL=llama-3.1-8b-instant

# Together.ai model (default: meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo)
# TOGETHER_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# NVIDIA NIM model (default: nvidia/nemotron-3-ultra)
# NIM_MODEL=nvidia/nemotron-4-340b-instruct

# ------------------------------------------------------------
# Storage locations (optional; defaults are fine for most users)
# ------------------------------------------------------------
# Where long-term memory is stored (default: erreetool-memory/
# next to the project, or the per-user data dir).
# ERREETOOL_MEMORY_DIR=

# Where per-session reports/output are written.
# ERREETOOL_OUTPUT_DIR=
